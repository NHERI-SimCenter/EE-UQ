//
// Optional built-in PEER NGA West 2 account for automatic login.
//
// Copy this file to PeerMasterLogin.h (same folder) and fill in the credentials.
// PeerMasterLogin.h is listed in .gitignore - NEVER commit it.
//
// If PeerMasterLogin.h exists at build time, PeerLoginDialog fills in and submits the
// PEER sign-in form automatically. If it does not exist, users log in themselves.
//
// NOTE: anything compiled in can be read out of the binary (e.g. with `strings`),
// so only ship builds containing this file to people you trust with the account.
//

#ifndef PEER_MASTER_LOGIN_H
#define PEER_MASTER_LOGIN_H

#define PEER_MASTER_EMAIL    "someone@example.com"
#define PEER_MASTER_PASSWORD "change-me"

#endif // PEER_MASTER_LOGIN_H
